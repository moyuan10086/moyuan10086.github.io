<script>
(function () {
  var form = document.getElementById('programmer-history-form');
  var monthInput = document.getElementById('programmer-history-month');
  var dayInput = document.getElementById('programmer-history-day');
  var submit = document.getElementById('programmer-history-submit');
  var today = document.getElementById('programmer-history-today');
  var dateLabel = document.getElementById('programmer-history-date');
  var list = document.getElementById('programmer-history-list');
  var baseUrl = 'https://uapis.cn/api/v1/history/programmer';

  if (!form || !monthInput || !dayInput || !submit || !today || !dateLabel || !list) return;

  function setLoading(isLoading) {
    submit.disabled = isLoading;
    today.disabled = isLoading;
  }

  function escapeHtml(value) {
    return String(value == null ? '' : value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function fetchJson(url) {
    var controller = window.AbortController ? new AbortController() : null;
    var timer = window.setTimeout(function () {
      if (controller) controller.abort();
    }, 6000);

    return fetch(url, controller ? { signal: controller.signal } : {})
      .then(function (res) {
        if (!res.ok) throw new Error('request failed');
        return res.json();
      })
      .finally(function () {
        window.clearTimeout(timer);
      });
  }

  function syncInputs(dateText) {
    var parts = String(dateText || '').split('-');
    if (parts.length !== 2) return;
    monthInput.value = String(parseInt(parts[0], 10) || '');
    dayInput.value = String(parseInt(parts[1], 10) || '');
  }

  function renderEvents(data) {
    var events = Array.isArray(data && data.events) ? data.events : [];
    dateLabel.textContent = data && data.date ? '程序员历史 ' + data.date : '程序员历史事件';
    if (data && data.date) syncInputs(data.date);

    if (!events.length) {
      list.innerHTML = '<li class="programmer-history-empty">这一天暂时没有收录到足够重要的程序员历史事件。</li>';
      return;
    }

    list.innerHTML = events.slice(0, 5).map(function (event) {
      var title = escapeHtml(event.title || '未命名事件');
      var titleHtml = event.url
        ? '<a class="history-event-title" href="' + escapeHtml(event.url) + '" target="_blank" rel="noopener">' + title + '</a>'
        : '<span class="history-event-title">' + title + '</span>';
      var category = event.category ? '<span>' + escapeHtml(event.category) + '</span>' : '';
      var importance = Number.isFinite(Number(event.importance)) ? '<span>重要性 ' + escapeHtml(event.importance) + '</span>' : '';

      return '<li class="programmer-history-event">' +
        '<div class="history-event-head">' +
          titleHtml +
          '<span class="history-year">' + escapeHtml(event.year || '') + '</span>' +
        '</div>' +
        '<p class="history-event-desc">' + escapeHtml(event.description || '暂无描述') + '</p>' +
        '<div class="history-event-meta">' + category + importance + '</div>' +
      '</li>';
    }).join('');
  }

  function showError(text) {
    dateLabel.textContent = '获取失败';
    list.innerHTML = '<li class="programmer-history-empty">' + escapeHtml(text || '稍后再试一下。') + '</li>';
  }

  function loadToday() {
    setLoading(true);
    dateLabel.textContent = '正在获取程序员历史上的今天...';
    list.innerHTML = '';
    fetchJson(baseUrl + '/today')
      .then(renderEvents)
      .catch(function () { showError('程序员历史事件暂时获取失败。'); })
      .finally(function () { setLoading(false); });
  }

  function loadByDate(month, day) {
    setLoading(true);
    dateLabel.textContent = '正在查询 ' + month + '-' + day + '...';
    list.innerHTML = '';
    fetchJson(baseUrl + '?month=' + encodeURIComponent(month) + '&day=' + encodeURIComponent(day))
      .then(renderEvents)
      .catch(function () { showError('日期参数或接口状态异常，请换个日期试试。'); })
      .finally(function () { setLoading(false); });
  }

  form.addEventListener('submit', function (event) {
    event.preventDefault();
    var month = parseInt(monthInput.value, 10);
    var day = parseInt(dayInput.value, 10);

    if (month < 1 || month > 12 || day < 1 || day > 31) {
      showError('请输入 1-12 的月份和 1-31 的日期。');
      return;
    }

    loadByDate(month, day);
  });

  function scheduleInitialHistoryLoad() {
    if (window.requestIdleCallback) {
      window.requestIdleCallback(loadToday, { timeout: 1800 });
      return;
    }

    window.setTimeout(loadToday, 800);
  }

  today.addEventListener('click', loadToday);
  if (document.readyState === 'complete') {
    scheduleInitialHistoryLoad();
  } else {
    window.addEventListener('load', scheduleInitialHistoryLoad, { once: true });
  }
})();
</script>
